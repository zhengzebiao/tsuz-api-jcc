# JCC product runtime example. Keep actual values in GitHub Environment Variables/Secrets.
APP_ENV=product
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30

SERVICE_NAME=tsuz-api-jcc
API_PREFIX=/api

# Compose project and shared network. tsuz-api-main creates the network first.
COMPOSE_PROJECT_NAME=tsuz-api-jcc-product
DOCKER_NETWORK_NAME=tsuz-api-main-prod

CONTAINER_NAME=jcc-api
NGINX_CONTAINER_NAME=jcc-api-nginx
APP_PORT=8001
NGINX_PORT=8081

# JCC-owned infrastructure containers are independent from tsuz-api-main.
DATABASE_URL=postgresql+psycopg://jcc_product:__JCC_POSTGRES_PASSWORD__@jcc-postgres-product:5432/tsuz_jcc
DB_SSLMODE=disable
POSTGRES_CONTAINER_NAME=jcc-postgres-product
POSTGRES_DB=tsuz_jcc
POSTGRES_USER=jcc_product
POSTGRES_PASSWORD=__JCC_POSTGRES_PASSWORD__
POSTGRES_PORT=15434
REDIS_URL=redis://jcc-redis-product:6379/0
REDIS_KEY_PREFIX=tsuz:jcc:product:cache:
REDIS_CONTAINER_NAME=jcc-redis-product
REDIS_PORT=16381
MAIN_REDIS_URL=redis://main-redis-prod:6379/0
TOKEN_BLACKLIST_PREFIX=tsuz:main:product:blacklist:jti:
SESSION_PREFIX=tsuz:main:product:session:

# JWT verification only; the JCC runtime has no signing key.
JWT_ALGORITHM=RS256
JWT_ISSUER=tsuz-api-main-prod
JWT_AUDIENCE=tsuz-api-main-prod
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n... matching tsuz-api-main product key ...\\n-----END PUBLIC KEY-----"

# Service Token settings. Use App IDs as Variables and one-time credentials as Secrets.
SERVICE_TOKEN_ISSUER=tsuz-api-main
SERVICE_TOKEN_AUDIENCE=__JCC_APP_ID__
SERVICE_TOKEN_CLOCK_SKEW_SECONDS=5
SERVICE_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n... matching main Service Token key ...\\n-----END PUBLIC KEY-----"
JCC_APP_ID=__JCC_APP_ID__
JCC_APP_SECRET=__JCC_APP_SECRET__
MAIN_APP_ID=__MAIN_APP_ID__
MAIN_TOKEN_URL=http://tsuz-api-main-prod:8000/internal/oauth/token
MAIN_API_BASE_URL=http://tsuz-api-main-prod:8000
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# Official data sync/import settings. This command is intentionally outside Deploy.
JCC_DATA_RAW_DIR=raw
JCC_DATA_MODE=18
JCC_DATA_MODE_NAME=自然之力
JCC_DATA_SYNC_TIMEOUT_SECONDS=30
JCC_DATA_SYNC_RETRIES=2

CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true
OPENAPI_ENABLED=false
DOCS_ENABLED=false
REDOC_ENABLED=false

# GitHub Environment Variables for health checks.
DEPLOY_HEALTH_RETRIES=30
DEPLOY_HEALTH_INTERVAL_SECONDS=5
# DEPLOY_PUBLIC_HEALTH_URL=https://jcc.example.com/health

# Init-only values (POSTGRES_PASSWORD belongs in an Environment Secret).
# INIT_HEALTH_RETRIES=30
# INIT_HEALTH_INTERVAL_SECONDS=2
