# Local JCC test environment. The shared network is created by tsuz-api-main.
APP_ENV=test
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30

SERVICE_NAME=tsuz-api-jcc-test
API_PREFIX=/api

# Host-side local API connections.
DATABASE_URL=postgresql+psycopg://jcc_test:jcc_test_password@127.0.0.1:15433/tsuz_jcc
DB_SSLMODE=disable
REDIS_URL=redis://127.0.0.1:16380/0
MAIN_REDIS_URL=redis://127.0.0.1:16379/0
REDIS_KEY_PREFIX=tsuz:jcc:test:cache:
TOKEN_BLACKLIST_PREFIX=tsuz:main:test:blacklist:jti:
SESSION_PREFIX=tsuz:main:test:session:

# JCC infrastructure values used by docker-compose.infra.yml.
POSTGRES_CONTAINER_NAME=jcc-postgres-test
POSTGRES_DB=tsuz_jcc
POSTGRES_USER=jcc_test
POSTGRES_PASSWORD=jcc_test_password
POSTGRES_PORT=15433
REDIS_CONTAINER_NAME=jcc-redis-test
REDIS_PORT=16380
COMPOSE_PROJECT_NAME=tsuz-api-jcc-test
# This network must already exist because tsuz-api-main owns it.
DOCKER_NETWORK_NAME=tsuz-api-main-test

# JWT verification only; copy the matching public key from tsuz-api-main.
JWT_ALGORITHM=RS256
JWT_ISSUER=tsuz-api-main-test
JWT_AUDIENCE=tsuz-api-main-test
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n... copy from tsuz-api-main .env ...\\n-----END PUBLIC KEY-----"

# App-to-app Service Token settings. Create identities in tsuz-api-main and
# inject real one-time values outside Git.
SERVICE_TOKEN_ISSUER=tsuz-api-main
SERVICE_TOKEN_AUDIENCE=__JCC_APP_ID__
SERVICE_TOKEN_CLOCK_SKEW_SECONDS=5
SERVICE_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n... matching main signing key ...\\n-----END PUBLIC KEY-----"
JCC_APP_ID=__JCC_APP_ID__
JCC_APP_SECRET=__JCC_APP_SECRET__
MAIN_APP_ID=__MAIN_APP_ID__
MAIN_TOKEN_URL=http://127.0.0.1:8000/internal/oauth/token
MAIN_API_BASE_URL=http://127.0.0.1:8000
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# Official JCC data sync/import settings. Deployment keeps this relative raw path
# on the Compose-managed /app/raw volume.
JCC_DATA_RAW_DIR=raw
JCC_DATA_VOLUME_NAME=tsuz-api-jcc-test-raw
JCC_DATA_MODE=18
JCC_DATA_MODE_NAME=自然之力
JCC_DATA_SYNC_TIMEOUT_SECONDS=30
JCC_DATA_SYNC_RETRIES=2

# Phase 2 Agent settings. Inject real values outside Git; leave blank to disable runtime startup locally.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=fake
RAG_EMBEDDING_MODEL=fake-test-1024
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RETRIEVAL_DEFAULT_LIMIT=5
RAG_RETRIEVAL_MAX_LIMIT=20
AGENT_QUEUE_MAXSIZE=1
AGENT_EXECUTION_TIMEOUT_SECONDS=180
AGENT_SHUTDOWN_TIMEOUT_SECONDS=10
AGENT_SSE_HEARTBEAT_SECONDS=15
AGENT_CONTEXT_MESSAGES=10
AGENT_MAX_TOOL_ITERATIONS=8
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_TOOL_INPUT_MAX_BYTES=16384
AGENT_TOOL_OUTPUT_MAX_BYTES=64000
AGENT_SOURCE_EXCERPT_MAX_CHARS=1000

CORS_ALLOW_ORIGINS=https://test.example.com,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
OPENAPI_ENABLED=true
DOCS_ENABLED=true
REDOC_ENABLED=true
