# Docker image name used by docker-compose.deploy.yml.
DOCKER_IMAGE_NAME=backend-api

# Immutable image/application version tag.
APP_VERSION=local

# Container names and host ports.
CONTAINER_NAME=backend-api
NGINX_CONTAINER_NAME=backend-api-nginx
APP_PORT=8000
NGINX_PORT=8080

# Deployment environment and shared Docker network.
APP_ENV=product
DOCKER_NETWORK_NAME=product-backend

# Runtime service settings.
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
SERVICE_NAME=backend-api
API_PREFIX=/api

# Infrastructure connection. Use GitHub Secrets for real values.
DATABASE_URL=postgresql+psycopg://app_user:change-me@product-postgres:5432/app
DB_SSLMODE=disable
REDIS_URL=redis://product-redis:6379/0
REDIS_KEY_PREFIX=auth:product:

# JWT common config.
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=backend-api
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Inject App IDs and one-time secrets from the deployment secret store.
SERVICE_TOKEN_ISSUER=tsuz-api-main
SERVICE_TOKEN_AUDIENCE=__JCC_APP_ID__
SERVICE_TOKEN_CLOCK_SKEW_SECONDS=5
SERVICE_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n... matching main signing key ...\n-----END PUBLIC KEY-----"
JCC_APP_ID=__JCC_APP_ID__
JCC_APP_SECRET=__JCC_APP_SECRET__
MAIN_APP_ID=__MAIN_APP_ID__
MAIN_TOKEN_URL=http://main-api:8000/internal/oauth/token
MAIN_API_BASE_URL=http://main-api:8000
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# Official JCC data sync and structured snapshot import.
JCC_DATA_RAW_DIR=raw
JCC_DATA_MODE=18
JCC_DATA_MODE_NAME=自然之力
JCC_DATA_SYNC_TIMEOUT_SECONDS=30
JCC_DATA_SYNC_RETRIES=2

TOKEN_BLACKLIST_PREFIX=auth:product:blacklist:jti:
SESSION_PREFIX=auth:product:session:

CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true

OPENAPI_ENABLED=false
DOCS_ENABLED=false
REDOC_ENABLED=false

# Optional deploy workflow health checks.
DEPLOY_HEALTH_RETRIES=30
DEPLOY_HEALTH_INTERVAL_SECONDS=5
# DEPLOY_PUBLIC_HEALTH_URL=https://api.example.com/health
