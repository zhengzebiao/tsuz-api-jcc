# JCC remote runtime example. Put real secret values in GitHub Environment Secrets.
# The generated remote .env is written with mode 0600 by Deploy.

# Registry and immutable image settings (GitHub Environment Variables).
DOCKER_REGISTRY=ccr.ccs.tencentyun.com
DOCKER_IMAGE_NAME=ccr.ccs.tencentyun.com/tsuz/tsuz-api-jcc-test
DOCKER_REGISTRY_USERNAME=__TCR_ACCOUNT_ID__
APP_VERSION=test-v1.0.0

# Deployment server and Compose settings (GitHub Environment Variables).
DEPLOY_HOST=__DEPLOY_HOST__
DEPLOY_PORT=22
DEPLOY_USER=__DEPLOY_USER__
DEPLOY_PATH=/opt/tsuz-api-jcc/runtime
DEPLOY_REPO_PATH=/opt/tsuz-api-jcc/source
DOCKER_BUILD_PLATFORM=linux/amd64
COMPOSE_PROJECT_NAME=tsuz-api-jcc-test
APP_ENV=test
DOCKER_NETWORK_NAME=tsuz-api-main-test

# JCC application containers and host ports.
CONTAINER_NAME=jcc-api
NGINX_CONTAINER_NAME=jcc-api-nginx
APP_PORT=8001
NGINX_PORT=8081

# Runtime service settings.
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
SERVICE_NAME=tsuz-api-jcc
API_PREFIX=/api
DB_SSLMODE=disable

# JCC-owned PostgreSQL and Redis. These containers are started by Init.
# Use the environment-specific container names reachable on the shared network.
DATABASE_URL=postgresql+psycopg://jcc_test:__JCC_POSTGRES_PASSWORD__@jcc-postgres-test:5432/tsuz_jcc
REDIS_URL=redis://jcc-redis-test:6379/0
REDIS_KEY_PREFIX=tsuz:jcc:test:cache:

# Main-service Redis remains the source of JWT blacklist/session state.
MAIN_REDIS_URL=redis://main-redis-test:6379/0
TOKEN_BLACKLIST_PREFIX=tsuz:main:test:blacklist:jti:
SESSION_PREFIX=tsuz:main:test:session:

# JWT verification only. JCC never receives the signing private key.
JWT_ALGORITHM=RS256
JWT_ISSUER=tsuz-api-main-test
JWT_AUDIENCE=tsuz-api-main-test
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n... matching tsuz-api-main key ...\n-----END PUBLIC KEY-----"

# App-to-app Service Token settings. App IDs are Variables; one-time secrets and
# public keys are Secrets. Values are placeholders only.
SERVICE_TOKEN_ISSUER=tsuz-api-main
SERVICE_TOKEN_AUDIENCE=__JCC_APP_ID__
SERVICE_TOKEN_CLOCK_SKEW_SECONDS=5
SERVICE_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n... matching main Service Token key ...\n-----END PUBLIC KEY-----"
JCC_APP_ID=__JCC_APP_ID__
JCC_APP_SECRET=__JCC_APP_SECRET__
MAIN_APP_ID=__MAIN_APP_ID__
MAIN_TOKEN_URL=http://tsuz-api-main-test:8000/internal/oauth/token
MAIN_API_BASE_URL=http://tsuz-api-main-test:8000
INTERNAL_HTTP_TIMEOUT_SECONDS=10

# Official data settings. Keep JCC_DATA_RAW_DIR=raw so the deployed API uses
# the Compose-managed /app/raw volume for scheduled and normal-release scans.
# JCC_DATA_VOLUME_NAME must be unique per environment/host.
JCC_DATA_RAW_DIR=raw
JCC_DATA_VOLUME_NAME=tsuz-api-jcc-test-raw
JCC_DATA_MODE=18
JCC_DATA_MODE_NAME=自然之力
JCC_DATA_SYNC_TIMEOUT_SECONDS=30
JCC_DATA_SYNC_RETRIES=2

CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true
OPENAPI_ENABLED=false
DOCS_ENABLED=false
REDOC_ENABLED=false

# Health checks (GitHub Environment Variables).
DEPLOY_HEALTH_RETRIES=30
DEPLOY_HEALTH_INTERVAL_SECONDS=5
# DEPLOY_PUBLIC_HEALTH_URL=https://jcc.example.com/health

# The following infrastructure values are consumed by Init as GitHub Variables or
# Secrets, then written to a separate remote .env.infra file:
# POSTGRES_CONTAINER_NAME=jcc-postgres-test
# POSTGRES_DB=tsuz_jcc
# POSTGRES_USER=jcc_test
# POSTGRES_PASSWORD=__JCC_POSTGRES_PASSWORD__
# POSTGRES_PORT=15433
# REDIS_CONTAINER_NAME=jcc-redis-test
# REDIS_PORT=16380
# INIT_HEALTH_RETRIES=30
# INIT_HEALTH_INTERVAL_SECONDS=2
